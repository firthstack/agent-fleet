# ────────────────────────────────────────────────────────────────
# The fleet gateway. One process, one job.
#
# Agents register with it, every message between them passes through it, and
# it owns the workflow composition layer — a workflow is a definition the
# gateway holds, not code inside an agent.
# ────────────────────────────────────────────────────────────────

FLEET_PORT=8790

# Postgres: tenants, agent registry, task ledger, workflow definitions and
# runs, audit. On InstaCloud, bind it rather than pasting a DSN:
#   insta secrets bind DATABASE_URL postgres/agent-db --to compute/<site>
DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# Seals the outbound credentials the gateway presents to agents.
# Generate with: openssl rand -hex 32
FLEET_SECRET_KEY=

# Public origin of this gateway. EVERY gateway URL and callback URL handed to
# an agent is built from it, so a wrong value means agents call back to an
# address that never reaches us.
FLEET_PUBLIC_BASE_URL=https://fleet.example.com

# Dev only: accept agent endpoints on http and on private addresses.
# Registering an agent is an outbound request the console lets any signed-in
# user trigger, so the SSRF checks in ssrf.ts are what keeps this from being
# an open proxy. Set to 1 only for a local gateway talking to an agent on
# 127.0.0.1.
FLEET_ALLOW_INSECURE_AGENTS=0

# ────────────────────────────────────────────────────────────────
# The console. A second identity axis: people, on /api/*, entirely
# separate from the agent bearer tokens on /a2a/*.
# ────────────────────────────────────────────────────────────────

# Signs Better Auth's session cookies. Same class of secret as
# FLEET_SECRET_KEY: leaking it means anyone can forge any user's session.
# Manage it with `insta secrets set`, not in a committed file.
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=

# Origins allowed to make authenticated console requests, comma-separated.
# The SPA is served from this same process, so in a normal deployment this is
# just FLEET_PUBLIC_BASE_URL — keep it tight, it is a CSRF control.
# Better Auth's own base URL is not configured separately: it is derived from
# FLEET_PUBLIC_BASE_URL, so there is one answer to "where does this run".
FLEET_TRUSTED_ORIGINS=https://fleet.example.com

# GitHub OAuth. Optional: leave both blank and sign-in falls back to email and
# password. Agents already work on GitHub, so for a developer this is the
# shorter path in.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Where `vite build` left the console. Defaults to dist/web; an absent
# directory just means the API is served without the SPA in front of it.
FLEET_WEB_ROOT=dist/web
