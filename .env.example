# ────────────────────────────────────────────────────────────────
# The fleet gateway. One process, one job.
#
# Agents register with it, every message between them passes through it, and
# it owns the workflow composition layer — a workflow is a definition the
# gateway holds, not code inside an agent.
# ────────────────────────────────────────────────────────────────

FLEET_PORT=8790

# Postgres: tenants, agent registry, task ledger, workflow definitions and
# runs, audit. On InstaCloud, bind it rather than pasting a DSN:
#   insta secrets bind DATABASE_URL postgres/agent-db --to compute/<site>
DATABASE_URL=postgres://user:pass@host:5432/db?sslmode=require

# Seals the outbound credentials the gateway presents to agents.
# Generate with: openssl rand -hex 32
FLEET_SECRET_KEY=

# Public origin of this gateway. EVERY gateway URL and callback URL handed to
# an agent is built from it, so a wrong value means agents call back to an
# address that never reaches us.
FLEET_PUBLIC_BASE_URL=https://fleet.example.com
